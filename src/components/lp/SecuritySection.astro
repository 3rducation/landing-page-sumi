---
const { security } = Astro.props;
---

<section id="security" class="py-20 md:py-16 bg-white">
  <div class="max-w-[1160px] mx-auto px-5 md:px-8">
    <div class="text-center mb-12">
      <p class="section-eyebrow copy-pre-line mb-3">{security.eyebrow}</p>
      <h2 class="section-heading copy-pre-line">{security.heading}</h2>
    </div>
    <figure class="overflow-hidden rounded-xl border border-[#DDE8E2] bg-white shadow-[0_16px_40px_rgba(15,61,46,0.08)]">
      <a
        href={security.imageSrc}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="データの流れを拡大して表示"
      >
        <img
          src={security.imageSrc}
          alt={security.imageAlt}
          width="1672"
          height="941"
          loading="lazy"
          decoding="async"
          class="block h-auto w-full"
        />
      </a>
    </figure>
  </div>
</section>
