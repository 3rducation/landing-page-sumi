---
const { gradingExamples, postGradingFeatures } = Astro.props;
---

<section id="features" class="py-10 md:py-16 bg-white">
  <div class="max-w-[1160px] mx-auto px-4 md:px-8">
    <div class="text-center mb-6 md:mb-12">
      <p class="section-eyebrow mb-3">特徴</p>
      <h2 class="section-heading">採点精度と確認効率を両立する、便利な機能</h2>
    </div>

    <div class="space-y-6">
      {gradingExamples.map((example, index) => (
        <div class="grid items-center gap-7 overflow-hidden rounded-xl border border-[#DDE8E2] bg-[#F8FBF9] p-5 shadow-[0_14px_36px_rgba(15,61,46,0.08)] md:p-7 lg:grid-cols-[0.72fr_1.28fr] lg:gap-9">
          <div class:list={[index % 2 === 1 && 'lg:order-2']}>
            <p class="text-xs font-bold tracking-widest text-[#1F6B4D]">{example.eyebrow}</p>
            <h3 class="copy-pre-line mt-3 text-xl font-bold leading-snug text-[#111827] md:text-2xl">
              {example.heading}
            </h3>
            <p class="mt-4 text-sm leading-relaxed text-[#4B5563]">
              {example.body}
            </p>
            {example.badges.length > 0 && (
              <div class="mt-5 flex flex-wrap gap-2">
                {example.badges.map((badge) => (
                  <span class="rounded-full border border-[#B9D7C7] bg-white px-3 py-1 text-[10px] font-bold text-[#1F6B4D] md:text-xs">
                    {badge}
                  </span>
                ))}
              </div>
            )}
            {example.note && (
              <p class="mt-4 text-[10px] leading-relaxed text-[#6B7280] md:text-xs">
                {example.note}
              </p>
            )}
          </div>

          <figure class:list={['mx-auto overflow-hidden rounded-lg border border-[#CFE0D7] bg-white', index % 2 === 1 && 'lg:order-1 max-w-[31rem]']}>
            <a
              href={example.imageSrc}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${example.eyebrow}の採点例を拡大して表示`}
            >
              <img
                src={example.imageSrc}
                alt={example.imageAlt}
                loading="lazy"
                decoding="async"
                class="block h-auto w-full"
              />
            </a>
          </figure>
        </div>
      ))}
    </div>

    <div class="mt-10 md:mt-12">
      <p class="section-eyebrow mb-5 text-center">採点後の業務も効率化</p>
      <div class="grid gap-4 md:grid-cols-[0.8fr_1.2fr]">
        {postGradingFeatures.map((feature) => (
          <article class="overflow-hidden rounded-xl border border-[#DDE8E2] bg-[#F8FBF9]">
            <a
              href={feature.imageSrc}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-40 items-center justify-center border-b border-[#DDE8E2] bg-white p-3 md:h-44"
              aria-label={`${feature.title}の画面を拡大して表示`}
            >
              <img
                src={feature.imageSrc}
                alt={feature.imageAlt}
                loading="lazy"
                decoding="async"
                class="block max-h-full w-auto max-w-full object-contain"
              />
            </a>
            <div class="p-4 md:p-5">
              <h3 class="text-base font-bold text-[#111827]">{feature.title}</h3>
              <p class="mt-2 text-xs leading-relaxed text-[#4B5563] md:text-sm">
                {feature.body}
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
