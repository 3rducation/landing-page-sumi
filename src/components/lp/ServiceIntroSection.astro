---
const { accuracyProof } = Astro.props;
---

<section id="accuracy" class="bg-[#FAFAF7] py-14 md:py-20">
  <div class="mx-auto max-w-[1160px] px-4 md:px-8">
    <div class="grid items-center gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14">
      <div>
        <p class="section-eyebrow mb-3">{accuracyProof.eyebrow}</p>
        <h2 class="section-heading copy-pre-line">{accuracyProof.heading}</h2>
        <p class="copy-pre-line mt-5 text-sm leading-relaxed text-[#4B5563] md:text-base">
          {accuracyProof.lead}
        </p>

        <div class="mt-7 rounded-xl border border-[#CFE4D9] bg-white px-5 py-6 shadow-[0_14px_36px_rgba(15,61,46,0.08)] md:px-7">
          <div class="flex flex-wrap items-end gap-x-3 gap-y-1">
            <strong class="text-5xl font-bold leading-none tracking-tight text-[#1F6B4D] md:text-6xl">
              {accuracyProof.value}
            </strong>
            <span class="pb-1 text-sm font-bold text-[#0F3D2E] md:text-base">
              {accuracyProof.valueLabel}
            </span>
          </div>
          <div class="mt-5 rounded-lg bg-[#F3FAF6] px-4 py-3">
            <p class="text-[10px] font-bold tracking-wide text-[#1F6B4D] md:text-xs">採点精度の算出方法</p>
            <p class="mt-1 text-xs leading-relaxed text-[#374151] md:text-sm">
              {accuracyProof.metricDefinition}
            </p>
            <p class="mt-2 text-[10px] font-semibold leading-relaxed text-[#0F3D2E] md:text-xs">
              {accuracyProof.metricFormula}
            </p>
          </div>
          <p class="mt-4 text-[10px] leading-relaxed text-[#6B7280] md:text-xs">
            {accuracyProof.valueNote}
          </p>
        </div>
      </div>

      <figure class="mx-auto w-full max-w-[24rem] overflow-hidden rounded-xl border border-[#DDE8E2] bg-white shadow-[0_18px_48px_rgba(15,61,46,0.1)]">
        <div class="flex items-center bg-[#1F6B4D] px-4 py-3 text-white md:px-6">
          <p class="text-sm font-bold md:text-base">AI一次判定イメージ</p>
        </div>
        <img
          src={accuracyProof.imageSrc}
          alt={accuracyProof.imageAlt}
          width="434"
          height="888"
          loading="lazy"
          decoding="async"
          class="block h-auto w-full"
        />
      </figure>
    </div>

    <div class="mt-10 grid gap-3 md:mt-14 md:grid-cols-3">
      {accuracyProof.workflow.map((item, index) => (
        <div class="relative flex items-center gap-4 rounded-xl border border-[#DDE8E2] bg-white px-4 py-4 md:px-5">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#1F6B4D] text-xs font-bold text-white">
            {item.step}
          </span>
          <p class="text-sm font-bold leading-snug text-[#111827]">{item.title}</p>
          {index < accuracyProof.workflow.length - 1 && (
            <span class="absolute -right-2.5 top-1/2 z-10 hidden -translate-y-1/2 text-lg font-bold text-[#A88B3D] md:block" aria-hidden="true">
              →
            </span>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
