---
const { problems } = Astro.props;
---

<section id="problem" class="py-10 md:py-16 bg-[#F6F8F7]">
  <div class="max-w-[1160px] mx-auto px-4 md:px-8">
    <div class="text-center mb-6 md:mb-12">
      <p class="section-eyebrow mb-3">従来の採点ツールの課題</p>
      <h2 class="section-heading">デジタル化しても、採点の負担は残っています</h2>
      <p class="text-[#4B5563] mt-3 max-w-xl mx-auto text-xs md:text-base leading-relaxed">
        従来の採点ツールは答案の整理や表示を効率化できる一方、判定や確認の多くは先生が担います。さらに、表記揺れ・長文記述・図の問題への対応にも課題が残ります。
      </p>
    </div>
    <div class="grid grid-cols-2 gap-3 md:hidden">
      {problems.map((problem, index) => (
        <button
          type="button"
        class="problem-mobile-card text-left bg-white border border-[#E5E7EB] rounded-lg px-3.5 py-4 shadow-sm min-h-[138px]"
          data-problem-index={index}
        >
          <img src={problem.iconSrc} alt="" class="w-9 h-9 mb-2.5 block" />
          <h3 class="copy-pre-line font-semibold text-[#111827] text-base leading-snug">{problem.title}</h3>
        </button>
      ))}
    </div>
    <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-4 gap-5">
      {problems.map((problem) => (
        <div class="card p-4 md:p-7 rounded-lg">
          <img src={problem.iconSrc} alt="" class="w-10 h-10 md:w-12 md:h-12 mb-3 md:mb-4 block" />
          <h3 class="copy-pre-line font-semibold text-[#111827] mb-2 text-sm md:text-base leading-snug">{problem.title}</h3>
          <p class="copy-pre-line text-xs md:text-sm text-[#4B5563] leading-relaxed"><span>{problem.body}</span>{problem.emphasis && <><strong class="font-bold text-[#111827]">{problem.emphasis}</strong><span>{problem.bodyAfter}</span></>}</p>
        </div>
      ))}
    </div>
  </div>

  <div
    id="problem-mobile-overlay"
    class="fixed inset-0 z-[70] hidden bg-[#111827]/55 px-4 py-6 md:hidden"
    aria-hidden="true"
  >
    <div class="flex min-h-full items-center justify-center">
        <div class="w-full max-w-sm rounded-lg bg-white p-6 shadow-2xl">
        <div class="flex items-start justify-between gap-4">
          <div>
            <img id="problem-mobile-overlay-icon" alt="" class="w-10 h-10" />
            <h3 id="problem-mobile-overlay-title" class="mt-3 text-xl font-bold leading-snug text-[#111827]"></h3>
          </div>
          <button
            type="button"
            id="problem-mobile-overlay-close"
            class="shrink-0 rounded-lg border border-[#E5E7EB] px-3 py-1 text-sm text-[#4B5563]"
            aria-label="閉じる"
          >
            閉じる
          </button>
        </div>
        <p class="mt-5 text-sm leading-7 text-[#4B5563]">
          <span id="problem-mobile-overlay-body"></span>
          <strong id="problem-mobile-overlay-emphasis" class="hidden font-bold text-[#111827]"></strong>
          <span id="problem-mobile-overlay-body-after"></span>
        </p>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ problems }}>
  const overlay = document.getElementById('problem-mobile-overlay');
  const overlayIcon = document.getElementById('problem-mobile-overlay-icon');
  const overlayTitle = document.getElementById('problem-mobile-overlay-title');
  const overlayBody = document.getElementById('problem-mobile-overlay-body');
  const overlayEmphasis = document.getElementById('problem-mobile-overlay-emphasis');
  const overlayBodyAfter = document.getElementById('problem-mobile-overlay-body-after');
  const closeBtn = document.getElementById('problem-mobile-overlay-close');

  const openOverlay = (index) => {
    const item = problems[index];
    if (!overlay || !overlayIcon || !overlayTitle || !overlayBody || !item) return;
    overlayIcon.setAttribute('src', item.iconSrc);
    overlayTitle.textContent = item.title;
    overlayBody.textContent = item.body;
    if (overlayEmphasis) {
      overlayEmphasis.textContent = item.emphasis || '';
      overlayEmphasis.classList.toggle('hidden', !item.emphasis);
    }
    if (overlayBodyAfter) {
      overlayBodyAfter.textContent = item.bodyAfter || '';
    }
    overlay.classList.remove('hidden');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  };

  const closeOverlay = () => {
    if (!overlay) return;
    overlay.classList.add('hidden');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  };

  document.querySelectorAll('[data-problem-index]').forEach((button) => {
    button.addEventListener('click', () => {
      const index = Number(button.getAttribute('data-problem-index'));
      openOverlay(index);
    });
  });

  closeBtn?.addEventListener('click', closeOverlay);
  overlay?.addEventListener('click', (event) => {
    if (event.target === overlay) closeOverlay();
  });
</script>
