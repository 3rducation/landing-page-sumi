---
const { company } = Astro.props;
---

<section id="about" class="company-section bg-white py-16 md:py-16">
  <div class="mx-auto grid max-w-[1160px] gap-10 px-4 md:grid-cols-[0.72fr_1.28fr] md:px-8 lg:gap-14">
    <div>
      <p class="section-eyebrow mb-3">{company.eyebrow}</p>
      <h2 class="section-heading copy-pre-line">{company.heading}</h2>

      <figure class="company-representative">
        <button
          type="button"
          class="company-representative__button"
          data-representative-open
          aria-label={`${company.representativeName}のプロフィールを表示`}
        >
          <img
            src={company.representativePhotoSrc}
            alt={company.representativePhotoAlt}
            class="company-representative__photo"
            loading="lazy"
          />
        </button>
        <figcaption class="company-representative__caption">
          <span>{company.representativeRole}</span>
          <strong>{company.representativeName}</strong>
        </figcaption>
        <button type="button" class="company-representative__hint" data-representative-open>
          プロフィールを見る
        </button>
      </figure>
    </div>

    <div class="space-y-7">
      <div class="company-story">
        <p>{company.lead}</p>
        <p><strong>{company.experienceLead}</strong>{company.experience}</p>
      </div>

      <div class="company-profile-wrap">
        <p class="company-profile__title">{company.profileTitle}</p>
        <dl class="company-profile">
          {company.profile.map((row) => (
            <div class="company-profile__row">
              <dt class="company-profile__label">{row.label}</dt>
              <dd class="company-profile__value">{row.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>

  <dialog
    id="representative-profile-modal"
    class="representative-modal"
    aria-labelledby="representative-profile-title"
  >
    <button
      type="button"
      class="representative-modal__close"
      data-representative-close
      aria-label="プロフィールを閉じる"
    >
      ×
    </button>
    <div class="representative-modal__content">
      <img
        src={company.representativePhotoSrc}
        alt=""
        class="representative-modal__photo"
      />
      <div>
        <p class="representative-modal__role">{company.representativeRole}</p>
        <h3 id="representative-profile-title" class="representative-modal__name">
          {company.representativeName}
        </h3>
        <div class="representative-modal__bio">
          {company.representativeBio.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>
    </div>
  </dialog>
</section>

<style>
  .company-section {
    border-top: 1px solid rgba(31, 107, 77, 0.12);
    border-bottom: 1px solid rgba(31, 107, 77, 0.12);
  }

  .company-representative {
    margin-top: 1.75rem;
    width: min(100%, 11.5rem);
  }

  .company-representative__button {
    display: block;
    width: 100%;
    cursor: zoom-in;
  }

  .company-representative__photo {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    border: 1px solid rgba(31, 107, 77, 0.14);
    border-radius: 8px;
    object-fit: cover;
    object-position: center top;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .company-representative__button:hover .company-representative__photo,
  .company-representative__button:focus-visible .company-representative__photo {
    border-color: rgba(31, 107, 77, 0.42);
    box-shadow: 0 10px 28px rgba(15, 61, 46, 0.13);
    transform: translateY(-2px);
  }

  .company-representative__button:focus-visible {
    border-radius: 8px;
    outline: 2px solid #1f6b4d;
    outline-offset: 3px;
  }

  .company-representative__caption {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    margin-top: 0.85rem;
    color: #334155;
  }

  .company-representative__caption span {
    font-size: 0.78rem;
    font-weight: 700;
  }

  .company-representative__caption strong {
    color: #111827;
    font-size: 1rem;
    letter-spacing: 0.04em;
  }

  .company-representative__hint {
    margin-top: 0.45rem;
    color: #1f6b4d;
    font-size: 0.72rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .representative-modal {
    width: min(calc(100% - 2rem), 40rem);
    max-height: calc(100dvh - 2rem);
    margin: auto;
    overflow: auto;
    border: 0;
    border-radius: 14px;
    background: #fff;
    padding: 0;
    box-shadow: 0 28px 80px rgba(15, 23, 42, 0.28);
  }

  .representative-modal::backdrop {
    background: rgba(15, 23, 42, 0.62);
    backdrop-filter: blur(4px);
  }

  .representative-modal__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 1;
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    color: #334155;
    font-size: 1.35rem;
    line-height: 1;
    box-shadow: 0 2px 12px rgba(15, 23, 42, 0.14);
  }

  .representative-modal__content {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: center;
    padding: 1.5rem;
  }

  .representative-modal__photo {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: 10px;
    object-fit: cover;
    object-position: center top;
  }

  .representative-modal__role {
    color: #1f6b4d;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .representative-modal__name {
    margin-top: 0.25rem;
    color: #111827;
    font-size: 1.7rem;
    font-weight: 800;
  }

  .representative-modal__bio {
    display: grid;
    gap: 0.85rem;
    margin-top: 1.35rem;
    color: #4b5563;
    font-size: 0.88rem;
    line-height: 1.9;
  }

  .company-story {
    display: grid;
    gap: 1rem;
    color: #374151;
    font-size: 0.95rem;
    line-height: 2;
  }

  .company-story strong {
    color: #1f6b4d;
    font-weight: 800;
  }

  @media (min-width: 768px) {
    .company-story {
      font-size: 1rem;
    }
  }

  .company-profile__title {
    margin-bottom: 1rem;
    color: #1f6b4d;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .company-profile-wrap {
    margin-top: 0.25rem;
  }

  .company-profile {
    border-top: 1px solid rgba(31, 107, 77, 0.16);
  }

  .company-profile__row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    border-bottom: 1px solid rgba(31, 107, 77, 0.12);
    padding: 0.95rem 0.25rem;
  }

  .company-profile__label {
    color: #1f6b4d;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .company-profile__value {
    color: #334155;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  @media (max-width: 767px) {
    .representative-modal__content {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding: 1rem;
    }

    .representative-modal__photo {
      width: min(100%, 9rem);
      margin-inline: auto;
    }

    .representative-modal__name {
      font-size: 1.4rem;
    }

    .company-profile__row {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }
</style>

<script>
  const profileDialog = document.getElementById('representative-profile-modal');
  const profileOpenButtons = document.querySelectorAll('[data-representative-open]');
  const profileCloseButton = document.querySelector('[data-representative-close]');

  if (profileDialog instanceof HTMLDialogElement) {
    profileOpenButtons.forEach((button) => {
      button.addEventListener('click', () => profileDialog.showModal());
    });

    profileCloseButton?.addEventListener('click', () => profileDialog.close());

    profileDialog.addEventListener('click', (event) => {
      if (event.target === profileDialog) profileDialog.close();
    });
  }
</script>
