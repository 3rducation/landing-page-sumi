---
const { pricing } = Astro.props;
---

<section id="pricing" class="pricing-section bg-[#F6F8F7] py-14 md:py-20">
  <div class="mx-auto max-w-[1160px] px-4 md:px-8">
    <div class="mb-10 text-center md:mb-12">
      <p class="section-eyebrow mb-3">{pricing.eyebrow}</p>
      <h2 class="section-heading copy-pre-line">{pricing.heading}</h2>
    </div>

    <div class="grid gap-5 lg:grid-cols-[0.92fr_1.08fr] lg:items-stretch">
      <article class="pricing-panel pricing-panel--price">
        <p class="pricing-panel__label">{pricing.startingPrice.label}</p>
        <div class="flex h-full flex-col items-center justify-center px-6 py-10 text-center md:px-10">
          <p class="text-6xl font-bold leading-none tracking-tight text-[#23823F] md:text-7xl">
            {pricing.startingPrice.amount}<span class="ml-2 text-2xl md:text-3xl">{pricing.startingPrice.unit}</span>
          </p>
          <p class="mt-3 text-sm font-semibold text-[#23823F]">{pricing.startingPrice.taxNote}</p>
          <div class="mt-8 w-full border-t border-dashed border-[#9CC7A5] pt-7">
            <p class="pricing-scale__label">{pricing.scale.label}</p>
            <h3 class="mt-2 whitespace-pre-line text-xl font-bold leading-relaxed text-[#0B2858] md:text-2xl">
              {pricing.scale.heading}
            </h3>
          </div>
        </div>
      </article>

      <article class="pricing-panel pricing-panel--inquiry">
        <div class="flex h-full flex-col px-6 py-9 md:px-10 md:py-10">
          <p class="section-eyebrow">お見積もり</p>
          <p class="mt-4 text-base leading-8 text-[#374151] md:text-lg">
            {pricing.scale.body}
          </p>
          <div class="pricing-credit mt-6">
            <p class="pricing-credit__label">{pricing.credit.label}</p>
            <h3 class="mt-1 text-base font-bold leading-relaxed text-[#0B2858] md:text-lg">
              {pricing.credit.heading}
            </h3>
            <p class="mt-1 text-sm leading-7 text-[#4B5563]">
              {pricing.credit.body}
            </p>
          </div>
          <div class="mt-7 border-t border-[#DCE5DE] pt-7">
            <h3 class="text-xl font-bold leading-relaxed text-[#0B2858] md:text-2xl">
              {pricing.inquiry.heading}
            </h3>
            <p class="mt-3 text-sm leading-7 text-[#4B5563] md:text-base">
              {pricing.inquiry.body}
            </p>
            <a class="pricing-inquiry__cta mt-6" href={pricing.inquiry.ctaHref}>
              {pricing.inquiry.ctaLabel}
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </article>
    </div>

    <p class="mt-4 text-right text-xs leading-relaxed text-[#4B5563] sm:text-sm">
      {pricing.priceNote}
    </p>
  </div>
</section>

<style>
  .pricing-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: 1px solid #b7c4d3;
    border-radius: 14px;
    background: #ffffff;
    box-shadow: 0 12px 30px rgba(11, 40, 88, 0.07);
  }

  .pricing-panel--price {
    border-color: #86b995;
    background: linear-gradient(145deg, #ffffff 0%, #f3faf6 100%);
  }

  .pricing-panel--inquiry {
    border-color: #d7bd75;
  }

  .pricing-panel__label {
    width: max-content;
    min-width: 9rem;
    margin: -1rem auto 0;
    border-radius: 10px;
    background: #0b2858;
    padding: 0.5rem 1.25rem;
    color: #ffffff;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
    text-align: center;
  }

  .pricing-scale__label {
    color: #806821;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .pricing-credit {
    border-radius: 0.75rem;
    background: #f3faf6;
    padding: 1rem 1.125rem;
  }

  .pricing-credit__label {
    color: #1f6b4d;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .pricing-inquiry__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    align-self: flex-start;
    border-radius: 999px;
    background: #1f6b4d;
    padding: 0.75rem 1rem;
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.4;
    text-decoration: none;
    transition: background-color 150ms ease, transform 150ms ease;
  }

  .pricing-inquiry__cta:hover {
    background: #0f3d2e;
    transform: translateY(-1px);
  }

  .pricing-inquiry__cta:focus-visible {
    outline: 3px solid #a88b3d;
    outline-offset: 3px;
  }

  @media (max-width: 640px) {
    .pricing-inquiry__cta {
      width: 100%;
    }
  }
</style>
