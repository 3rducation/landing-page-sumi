---
const { effectComparison } = Astro.props;
---

<section class="py-10 md:py-16 bg-[#FAFAF7]">
  <div class="max-w-[1160px] mx-auto px-4 md:px-8">
    <div class="text-center mb-6 md:mb-12">
      <p class="section-eyebrow mb-3">期待できる効果</p>
      <h2 class="section-heading">高精度な一次判定で、採点時間を減らす</h2>
    </div>

    <div class="mb-8 md:mb-12">
      <div class="mb-5 text-center">
        <p class="text-xl md:text-3xl font-bold text-[#0F3D2E] leading-tight">
          {effectComparison.heading}
        </p>
        <p class="mt-2 text-sm md:text-base text-[#4B5563] leading-relaxed max-w-3xl mx-auto">
          {effectComparison.body}
        </p>
      </div>
      <figure class="overflow-hidden rounded-xl border border-[#DDE8E2] bg-white shadow-[0_16px_40px_rgba(15,61,46,0.08)]">
        <img
          src={effectComparison.imageSrc}
          alt={effectComparison.imageAlt}
          width="1672"
          height="941"
          loading="lazy"
          decoding="async"
          class="block w-full h-auto"
        />
      </figure>
    </div>
  </div>
</section>
