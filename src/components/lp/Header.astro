---
const { nav } = Astro.props;
---

<header
  id="site-header"
  class="site-header sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-[#E5E7EB]"
>
  <div class="site-header__inner site-header__inner--desktop max-w-[1640px] mx-auto px-4 md:px-6 lg:px-8 xl:px-10 2xl:px-14 items-center justify-between gap-3">
    <a href="/" class="site-header__brand flex items-center gap-2 shrink-0">
      <span class="site-header__service-label">生成AI自動採点</span>
      <img
        id="site-logo"
        src="/images/sumi-logo-river-v2.png"
        alt="AI自動採点「澄」"
        class="site-header__logo w-auto"
      />
    </a>

    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-[#4B5563]">
      {nav.map((item) => (
        <a href={item.href} class="site-header__nav-link">{item.label}</a>
      ))}
    </nav>

    <a href="#contact" class="site-header__cta site-header__cta--desktop btn-primary text-sm">
      資料請求・デモ相談
    </a>
  </div>

  <div class="site-header__inner site-header__inner--mobile max-w-[1640px] mx-auto px-4 items-center gap-2">
    <a href="/" class="site-header__brand site-header__brand--mobile flex items-center shrink-0">
      <span class="site-header__service-label site-header__service-label--mobile">生成AI自動採点</span>
      <img
        src="/images/sumi-logo-river-v2.png"
        alt="AI自動採点「澄」"
        class="site-header__logo site-header__logo--mobile w-auto"
      />
    </a>
    <button
      id="mobile-menu-btn"
      class="site-header__menu-btn md:hidden p-2 rounded-lg hover:bg-[#F3FAF6] transition-colors shrink-0"
      aria-label="メニューを開く"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-[#E5E7EB] bg-white">
    <div class="px-5 py-4 flex flex-col gap-4">
      {nav.map((item) => (
        <a href={item.href} class="text-sm font-medium text-[#4B5563] hover:text-[#1F6B4D]">{item.label}</a>
      ))}
      <a href="#contact" class="btn-primary text-sm text-center mt-2">資料請求・デモ相談</a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => menu?.classList.add('hidden'));
  });

  const header = document.getElementById('site-header');
  const syncHeaderState = () => {
    if (!header) return;
    header.dataset.scrolled = window.scrollY > 24 ? 'true' : 'false';
  };

  syncHeaderState();
  window.addEventListener('scroll', syncHeaderState, { passive: true });
</script>

<style>
  .site-header {
    --header-height-desktop: 5.4rem;
    --header-height-desktop-scrolled: 4.7rem;
    --logo-height-desktop: 3.15rem;
    --logo-height-desktop-scrolled: 2.65rem;

    --header-height-mobile: 4.8rem;
    --header-height-mobile-scrolled: 4.15rem;
    --logo-height-mobile: 2.55rem;
    --logo-height-mobile-scrolled: 2.2rem;
    width: 100%;
    max-width: 100vw;
    overflow: hidden;
  }

  .site-header,
  .site-header__inner,
  .site-header__logo {
    transition:
      height 0.24s ease,
      padding 0.24s ease,
      transform 0.24s ease;
  }

  .site-header__inner {
    height: var(--header-height-desktop);
  }

  .site-header__inner--desktop {
    display: flex;
  }

  .site-header__inner--mobile {
    display: none;
  }

  .site-header__logo {
    height: var(--logo-height-desktop);
  }

  .site-header__service-label {
    color: #1f6b4d;
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    white-space: nowrap;
  }

  .site-header__cta {
    padding: 0.7rem 1.4rem;
    font-size: 0.9375rem;
  }

  .site-header__cta--desktop {
    display: inline-flex;
  }

  .site-header__nav-link {
    position: relative;
    padding: 0.55rem 0;
    transition: color 0.2s ease;
  }

  .site-header__nav-link::after {
    position: absolute;
    right: 0;
    bottom: 0.2rem;
    left: 0;
    height: 2px;
    border-radius: 999px;
    background: #1f6b4d;
    content: "";
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.2s ease;
  }

  .site-header__nav-link:hover,
  .site-header__nav-link:focus-visible {
    color: #1f6b4d;
  }

  .site-header__nav-link:hover::after,
  .site-header__nav-link:focus-visible::after {
    transform: scaleX(1);
  }

  .site-header[data-scrolled="true"] .site-header__inner {
    height: var(--header-height-desktop-scrolled);
  }

  .site-header[data-scrolled="true"] .site-header__logo {
    height: var(--logo-height-desktop-scrolled);
  }

  @media (max-width: 767px) {
    .site-header__inner--desktop {
      display: none;
    }

    .site-header__inner--mobile {
      display: flex;
    }

    .site-header__inner {
      width: 100%;
      max-width: 100vw;
      height: var(--header-height-mobile);
      padding-left: 0.85rem;
      padding-right: 0.85rem;
      gap: 0.5rem;
      justify-content: space-between;
    }

    .site-header__brand--mobile {
      flex: 0 0 auto;
      width: 14.25rem;
      height: var(--header-height-mobile);
      max-width: calc(100vw - 4.6rem);
      overflow: visible;
    }

    .site-header__logo--mobile {
      max-width: none;
      height: var(--logo-height-mobile);
      transform: none;
    }

    .site-header__service-label--mobile {
      font-size: 0.82rem;
      letter-spacing: 0.06em;
    }

    .site-header__cta--desktop {
      display: none;
    }

    .site-header__menu-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      height: 2.75rem;
      padding: 0;
    }

    .site-header[data-scrolled="true"] .site-header__inner {
      height: var(--header-height-mobile-scrolled);
    }

    .site-header[data-scrolled="true"] .site-header__logo--mobile {
      height: var(--logo-height-mobile-scrolled);
      transform: none;
    }

    .site-header[data-scrolled="true"] .site-header__menu-btn {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>
