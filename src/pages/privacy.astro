---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import { meta, privacyPolicy } from '../data/lpContent';
---

<BaseLayout
  title={`プライバシーポリシー | 合同会社3rducation`}
  description="合同会社3rducationが提供するAI自動採点サービス「澄」および当社ウェブサイトにおける個人情報の取扱いについてご案内します。"
  siteUrl={meta.siteUrl}
  image={meta.image}
  keywords={["プライバシーポリシー", "3rducation", "AI自動採点 澄"]}
>
  <header class="border-b border-[#DDE7E1] bg-white/95 backdrop-blur">
    <div class="mx-auto flex max-w-[980px] items-center justify-between gap-5 px-5 py-4 md:px-8">
      <a href="/" aria-label="AI自動採点「澄」のトップページへ戻る">
        <img
          src="/images/logo-transparent.png"
          alt="3rducation"
          class="h-9 w-auto"
        />
      </a>
      <a
        href="/"
        class="text-sm font-semibold text-[#1F6B4D] transition-colors hover:text-[#0F3D2E] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1F6B4D]"
      >サービスサイトへ戻る</a>
    </div>
  </header>

  <main class="bg-[#F4F7F2]/95 py-12 md:py-20">
    <article class="mx-auto max-w-[980px] px-5 md:px-8">
      <div class="rounded-2xl border border-[#DDE7E1] bg-white px-6 py-9 shadow-[0_18px_50px_rgba(15,61,46,0.08)] md:px-12 md:py-14">
        <p class="section-eyebrow">PRIVACY POLICY</p>
        <h1 class="mt-2 text-2xl font-bold leading-relaxed text-[#111827] md:text-4xl">
          {privacyPolicy.title}
        </h1>
        <p class="mt-8 text-sm leading-8 text-[#374151] md:text-base">
          {privacyPolicy.intro}
        </p>

        <div class="mt-12 space-y-12">
          {privacyPolicy.sections.map((section) => (
            <section aria-labelledby={`privacy-${section.title.split('（')[0]}`}>
              <h2
                id={`privacy-${section.title.split('（')[0]}`}
                class="border-l-4 border-[#A88B3D] pl-4 text-lg font-bold leading-relaxed text-[#0F3D2E] md:text-xl"
              >
                {section.title}
              </h2>
              <div class="mt-5 space-y-5 text-sm leading-8 text-[#374151] md:text-base">
                {section.blocks.map((block) => (
                  block.type === 'paragraph' ? (
                    <p class="whitespace-pre-line">{block.text}</p>
                  ) : block.type === 'definitions' ? (
                    <dl class="grid gap-2 rounded-xl bg-[#F7FAF8] px-5 py-4">
                      {block.items.map((item) => (
                        <div class="grid gap-1 sm:grid-cols-[7.5rem_1fr]">
                          <dt class="font-semibold text-[#0F3D2E]">{item.label}</dt>
                          <dd>{item.value}</dd>
                        </div>
                      ))}
                    </dl>
                  ) : block.type === 'group' ? (
                    <div>
                      <h3 class="font-semibold text-[#1F2937]">{block.title}</h3>
                      <ul class="mt-2 list-disc space-y-1 pl-6 marker:text-[#A88B3D]">
                        {block.items.map((item) => <li>{item}</li>)}
                      </ul>
                    </div>
                  ) : block.type === 'orderedList' ? (
                    <ol
                      class="list-decimal space-y-2 pl-6 marker:font-semibold marker:text-[#1F6B4D]"
                      start={block.start}
                    >
                      {block.items.map((item) => <li class="pl-1">{item}</li>)}
                    </ol>
                  ) : (
                    <ul class="list-disc space-y-1 pl-6 marker:text-[#A88B3D]">
                      {block.items.map((item) => <li>{item}</li>)}
                    </ul>
                  )
                ))}
              </div>
            </section>
          ))}
        </div>

        <p class="mt-14 border-t border-[#E5E7EB] pt-6 text-right text-sm font-semibold text-[#4B5563]">
          {privacyPolicy.effectiveDate}
        </p>
      </div>
    </article>
  </main>

  <footer class="bg-[#0F3D2E] py-7 text-center text-xs text-white/50">
    © {new Date().getFullYear()} 合同会社3rducation. All rights reserved.
  </footer>
</BaseLayout>
